{
    "name": "jardisadapter/messaging",
    "homepage": "https://jardis.io",
    "description": "Multi-transport messaging for Redis, Kafka, RabbitMQ, and Database with automatic serialization and consumer groups; a building block of the open-source foundation that Jardis-generated DDD code runs on",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Jardis Development",
            "email": "jardisDev@headgent.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jardissupport/contracts": "^1.0 || ^2.0",
        "ext-pcntl": "*",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-redis": "Required for Redis Streams/Pub-Sub transport",
        "ext-rdkafka": "Required for Apache Kafka transport",
        "ext-amqp": "Required for RabbitMQ transport"
    },
    "require-dev": {
        "phpunit/phpunit": "10.5.63",
        "phpstan/phpstan": "2.2.8",
        "squizlabs/php_codesniffer": "3.13.6",
        "ext-redis": "*",
        "ext-amqp": "*",
        "ext-rdkafka": "*"
    },
    "autoload": {
        "psr-4": {
            "JardisAdapter\\Messaging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JardisAdapter\\Messaging\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/jardisAdapter/messaging/issues",
        "docs": "https://docs.jardis.io/en/adapter/messaging",
        "email": "jardisDev@headgent.com"
    },
    "keywords": [
        "messaging",
        "message-queue",
        "kafka",
        "rabbitmq",
        "redis",
        "php",
        "domain-driven-design",
        "hexagonal-architecture",
        "jardis",
        "headgent"
    ]
}
